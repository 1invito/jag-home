<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.jag.home">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:label="JAG Home" android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:theme="@style/Jag" android:allowBackup="false" android:supportsRtl="false">
        <!-- Effective HOME is a narrowly scoped Fire OS Guard. Installing adds no HOME resolver. -->
        <activity android:name="com.jag.home.dev.Home" android:exported="true" android:launchMode="singleTask"
            android:screenOrientation="landscape" android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name="com.jag.home.dev.Preferences" android:exported="false" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <service android:name="com.jag.home.integration.HomeGuard" android:exported="true"
            android:label="JAG Home redirector" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/jag_guard" />
        </service>
        <!-- DUMP is a sender restriction, not an application permission request. Ordinary apps cannot arm HOME. -->
        <receiver android:name="com.jag.home.integration.HomeControl" android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name="com.jag.home.integration.Boot" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>
</manifest>
